# Production Environment Configuration for StrangerVerse Frontend
# Empty VITE_SERVER_URL automatically binds API endpoints to the same Vercel production origin
VITE_SERVER_URL=

# Optional: Real Firebase Web Credentials for live Google Sign-In popup
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Optional: Metered/OpenRelay TURN server credentials for symmetric NAT voice calls
# VITE_TURN_SERVER_URL=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
