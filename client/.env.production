# Production Environment Configuration for StrangerVerse Frontend
VITE_SOCKET_URL=https://felt-mega-passes-word.trycloudflare.com

# Empty VITE_SERVER_URL automatically binds REST API endpoints to native Vercel Edge functions
VITE_SERVER_URL=

